# Gemini API key for RAG brief generation.
# The real value lives in track2_rag/.env today (see that file) -- not committed here.
GEMINI_API_KEY=

# Path to the anomaly GeoJSON FeatureCollection the API serves.
# Defaults to contract/mock_anomalies.geojson if unset. Point this at
# data/anomalies_v1.geojson once Track 1 delivers the real file -- no code
# change required.
SPOONBILL_ANOMALIES_PATH=

# Set to 1 to disable all live Gemini calls. Brief endpoints then serve only
# cached data/briefs/*.json files and return 503 on a cache miss, instead of
# attempting an outbound call. Use this for offline/no-wifi demos.
SPOONBILL_OFFLINE=
